{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://speq.dev/schemas/test.schema.json",
  "title": "SPEQ Test Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique test identifier."
    },
    "title": {
      "type": "string",
      "description": "Human-readable test title."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional tags used for filtering."
    },
    "variables": {
      "type": "object",
      "description": "Per-test variables available in templates.",
      "additionalProperties": {
        "oneOf": [
          { "type": ["string", "number", "boolean", "null"] },
          { "$ref": "#/definitions/genValue" }
        ]
      }
    },
    "imports": {
      "type": "array",
      "description": "Imported modules for use.action syntax.",
      "items": {
        "$ref": "#/definitions/importSpec"
      }
    },
    "setup": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/step"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/step"
      }
    },
    "cleanup": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/step"
      }
    }
  },
  "definitions": {
    "genValue": {
      "type": "object",
      "description": "Data generator block.",
      "required": ["gen"],
      "additionalProperties": false,
      "properties": {
        "gen": { "$ref": "#/definitions/genConfig" }
      }
    },
    "genConfig": {
      "type": "object",
      "description": "Generator configuration.",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["uuid", "date-time", "string", "int", "bool", "email", "name"],
          "description": "Generator type."
        },
        "format": {
          "type": "string",
          "enum": ["rfc3339", "iso8601"],
          "description": "Date-time format (only for type: date-time)."
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum string length (only for type: string)."
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum string length (only for type: string)."
        },
        "min": {
          "type": "integer",
          "description": "Minimum integer value (only for type: int)."
        },
        "max": {
          "type": "integer",
          "description": "Maximum integer value (only for type: int)."
        }
      }
    },
    "bodyValue": {
      "description": "A body field: plain JSON scalar, a gen block, nested object, or array.",
      "oneOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "$ref": "#/definitions/genValue" },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/bodyValue" }
        },
        {
          "type": "array",
          "items": { "$ref": "#/definitions/bodyValue" }
        }
      ]
    },
    "bodyFromFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "description": "Reference to a fixture file used as the request body.",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the fixture file relative to fixturesDir."
        },
        "overrides": {
          "type": "object",
          "additionalProperties": true,
          "description": "Key-value pairs that override fixture build values."
        }
      }
    },
    "importSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module"
      ],
      "properties": {
        "module": {
          "type": "string",
          "description": "Module path under modulesDir."
        },
        "alias": {
          "type": "string",
          "description": "Optional alias for action calls."
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "api",
            "use"
          ],
          "description": "Step type: direct API call or reusable action."
        },
        "name": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ]
        },
        "url": {
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "$ref": "#/definitions/bodyValue"
        },
        "bodyFromFixture": {
          "$ref": "#/definitions/bodyFromFixture",
          "description": "Use a fixture file as the request body."
        },
        "ref": {
          "type": "string",
          "description": "Reusable yaml file for use step."
        },
        "action": {
          "type": "string",
          "description": "Imported module action in <alias>.<action> format."
        },
        "properties": {
          "type": "object",
          "description": "Parameters passed to use.action.",
          "additionalProperties": true
        },
        "as": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
          "description": "Binds action returns into the test context under this identifier (e.g. 'login' → {{login.token}})."
        },
        "assert": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/assertion"
          }
        },
        "condition": {
          "$ref": "#/definitions/condition",
          "description": "Condition that must be met; enables waiter polling until satisfied or timeout."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "api"
              }
            }
          },
          "then": {
            "required": [
              "method",
              "url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "use"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "ref"
                ]
              },
              {
                "required": [
                  "action"
                ]
              }
            ]
          }
        }
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "status",
            "json",
            "contains",
            "notcontains",
            "exists",
            "regex",
            "schema"
          ],
          "description": "Assertion type, includes schema validation."
        },
        "path": {
          "type": "string"
        },
        "expected": {},
        "value": {},
        "ref": {
          "type": "string",
          "description": "Schema file path relative to schemasDir."
        },
        "inline": {
          "description": "Inline JSON Schema document."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "schema"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "ref"
                ]
              },
              {
                "required": [
                  "inline"
                ]
              }
            ]
          }
        }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "equals"],
      "description": "Condition evaluated against the response body. Enables waiter polling when combined with 'wait'.",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["jsonpath"],
          "description": "Condition evaluation strategy. Currently only 'jsonpath' is supported."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "JSONPath expression evaluated against the response body (e.g. '$.state')."
        },
        "equals": {
          "description": "Expected value at the JSONPath location."
        },
        "wait": {
          "$ref": "#/definitions/waitConfig"
        }
      }
    },
    "waitConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "intervalMs"],
      "description": "Polling configuration used with 'condition' to retry the request until the condition is met.",
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum total wait time in milliseconds before the step fails with wait_timeout."
        },
        "intervalMs": {
          "type": "integer",
          "minimum": 1,
          "description": "Time between polling attempts in milliseconds."
        }
      }
    }
  }
}
